{UTF-8}
Clientes Potenciales= INTEG (
	clientes que abandonan-nuevos clientes,
		Tamaño del Mercado - Clientes Semilla)
	~	persona
	~	
	|

Clientes= INTEG (
	nuevos clientes-clientes que abandonan,
		Clientes Semilla)
	~	persona
	~	
	|

nuevos clientes=
	ventas / tamaño de la venta
	~	persona/Año
	~	
	|

clientes que abandonan=
	Clientes / tiempo de obsolescencia
	~	persona/Año
	~	
	|

Clientes Semilla=
	10000
	~	persona
	~	
	|

ventas=
	(ventas potenciales boca a boca + ventas potenciales por publicidad) * fracción con prospectos reales
	~	Unidad/Año
	~	
	|

tamaño de la venta=
	1
	~	Unidad/persona
	~	
	|

fracción con prospectos reales=
	Clientes Potenciales / Tamaño del Mercado
	~	Dmnl
	~	
	|

Tamaño del Mercado=
	1e+08
	~	persona
	~	
	|

ventas potenciales boca a boca=
	Clientes * efectividad de ventas por cliente
	~	Unidad/Año
	~	
	|

efectividad de ventas por cliente=
	3
	~	Unidad/(Año*persona)
	~	
	|

ventas potenciales por publicidad=
	gasto en publicidad * efectividad de la publicidad
	~	Unidad/Año
	~	
	|

gasto en publicidad=
	GAME(c gasto en publicidad)
	~	dólar/Año
	~	
	|

c gasto en publicidad=
	2e+07
	~	dólar/Año
	~	
	|

efectividad de la publicidad=
	0.1
	~	Unidad/dólar
	~	
	|

tiempo de obsolescencia=
	2
	~	Año
	~	
	|

GAME INTERVAL=
	0.5
	~	Año
	~	Intervalo por defecto entre pasos del juego.		:SUPPLEMENTARY 
	|

********************************************************
	.Control
********************************************************~
		Parametros de control de la simulacion
	|

FINAL TIME  = 5
	~	Año
	~	El tiempo final de la simulacion.
	|

INITIAL TIME  = 0
	~	Año
	~	El tiempo inicial de la simulacion.
	|

SAVEPER  = 
        TIME STEP
	~	Año [0,?]
	~	Frecuencia con la que se guarda la salida.
	|

TIME STEP  = 0.0625
	~	Año [0,?]
	~	Paso de tiempo de la simulacion.
	|

