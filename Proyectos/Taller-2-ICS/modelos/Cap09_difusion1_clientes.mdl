{UTF-8}
Clientes Potenciales= INTEG (
	-nuevos clientes,
		1e+06)
	~	persona
	~	Personas que aún no tienen el producto pero podrían comprarlo.
	|

Clientes= INTEG (
	nuevos clientes,
		1000)
	~	persona
	~	Personas que ya poseen el producto.
	|

nuevos clientes=
	demanda boca a boca
	~	persona/Mes
	~	Personas que compran el producto cada mes.
	|

demanda boca a boca=
	contactos de no clientes con clientes * fructuosidad
	~	persona/Mes
	~	Compras que generaría el boca a boca si no hubiera restricciones.
	|

fructuosidad=
	0.01
	~	persona/contactos
	~	Fracción de contactos con clientes que termina en una compra.
	|

contactos de no clientes con clientes=
	contactos con clientes * concentración de clientes potenciales
	~	contactos/Mes
	~	
	|

contactos con clientes=
	Clientes * sociabilidad
	~	contactos/Mes
	~	
	|

sociabilidad=
	20
	~	contactos/persona/Mes
	~	Contactos que hace cada cliente por mes.
	|

concentración de clientes potenciales=
	Clientes Potenciales / mercado total
	~	Dmnl
	~	Probabilidad de que un contacto de un cliente sea con un no cliente.
	|

mercado total=
	Clientes + Clientes Potenciales
	~	persona
	~	
	|

********************************************************
	.Control
********************************************************~
		Parametros de control de la simulacion
	|

FINAL TIME  = 100
	~	Mes
	~	El tiempo final de la simulacion.
	|

INITIAL TIME  = 0
	~	Mes
	~	El tiempo inicial de la simulacion.
	|

SAVEPER  = 
        TIME STEP
	~	Mes [0,?]
	~	Frecuencia con la que se guarda la salida.
	|

TIME STEP  = 1
	~	Mes [0,?]
	~	Paso de tiempo de la simulacion.
	|

