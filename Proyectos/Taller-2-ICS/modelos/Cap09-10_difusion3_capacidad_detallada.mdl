{UTF-8}
Clientes Potenciales= INTEG (
	-nuevos clientes,
		1e+06)
	~	persona
	~	Personas que aún no tienen el producto pero podrían comprarlo.
	|

Clientes= INTEG (
	nuevos clientes,
		1000)
	~	persona
	~	Personas que ya poseen el producto.
	|

nuevos clientes=
	MIN(demanda boca a boca, producción/unidades por persona)
	~	persona/Mes
	~	Personas que compran el producto cada mes.
	|

demanda boca a boca=
	contactos de no clientes con clientes * fructuosidad
	~	persona/Mes
	~	Compras que generaría el boca a boca si no hubiera restricciones.
	|

fructuosidad=
	0.01
	~	persona/contactos
	~	Fracción de contactos con clientes que termina en una compra.
	|

contactos de no clientes con clientes=
	contactos con clientes * concentración de clientes potenciales
	~	contactos/Mes
	~	
	|

contactos con clientes=
	Clientes * sociabilidad
	~	contactos/Mes
	~	
	|

sociabilidad=
	20
	~	contactos/persona/Mes
	~	Contactos que hace cada cliente por mes.
	|

concentración de clientes potenciales=
	Clientes Potenciales / mercado total
	~	Dmnl
	~	Probabilidad de que un contacto de un cliente sea con un no cliente.
	|

mercado total=
	Clientes + Clientes Potenciales
	~	persona
	~	
	|

Capacidad= INTEG (
	inversión-reducciones,
		capacidad objetivo)
	~	Aparato/Mes
	~	Capacidad instalada; crece con la inversión y se deprecia con su vida útil.
	|

inversión=
	ajuste de capacidad
	~	Aparato/Mes/Mes
	~	
	|

reducciones=
	Capacidad / vida de la capacidad
	~	Aparato/(Mes*Mes)
	~	
	|

ajuste de capacidad=
	(capacidad objetivo - Capacidad) / tiempo para ajustar la capacidad
	~	Aparato/Mes/Mes
	~	
	|

tiempo para ajustar la capacidad=
	12
	~	Mes
	~	
	|

capacidad objetivo=
	producción deseada
	~	Aparato/Mes
	~	
	|

vida de la capacidad=
	20
	~	Mes
	~	
	|

producción potencial=
	Capacidad
	~	Aparato/Mes
	~	
	|

producción=
	MIN(producción deseada, producción potencial)
	~	Aparato/Mes
	~	
	|

producción deseada=
	demanda boca a boca * unidades por persona
	~	Aparato/Mes
	~	
	|

unidades por persona=
	1
	~	Unidad/persona
	~	
	|

ventas=
	nuevos clientes * unidades por persona
	~	Unidad/Mes
	~	
	|

precio=
	50
	~	dólar/Unidad
	~	
	|

Ingresos Acumulados= INTEG (
	ingresos por ventas,
		0)
	~	dólar
	~	Ingresos totales recibidos por la venta del producto.		:SUPPLEMENTARY 
	|

ingresos por ventas=
	ventas * precio
	~	dólar/Mes
	~	
	|

********************************************************
	.Control
********************************************************~
		Parametros de control de la simulacion
	|

FINAL TIME  = 100
	~	Mes
	~	El tiempo final de la simulacion.
	|

INITIAL TIME  = 0
	~	Mes
	~	El tiempo inicial de la simulacion.
	|

SAVEPER  = 
        TIME STEP
	~	Mes [0,?]
	~	Frecuencia con la que se guarda la salida.
	|

TIME STEP  = 1
	~	Mes [0,?]
	~	Paso de tiempo de la simulacion.
	|

