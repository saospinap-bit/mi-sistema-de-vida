{UTF-8}
Susceptibles= INTEG (
	expuestos-enferman-vacunados,
		900)
	~	
	~	
	|

Infectados= INTEG (
	enferman-curan-muertes,
		100)
	~	[50,150]
	~	Rango [50,150]: Vensim avisa (warning) cuando Infectados sale de este rango.
	|

Recuperados= INTEG (
	curan+vacunados-expuestos,
		0)
	~	
	~	
	|

enferman=
	Susceptibles*tasa de contagio*Infectados
	~	
	~	Fórmula de Kermack y McKendrick: beta*S*I.
	|

curan=
	Infectados*tasa de curación
	~	
	~	
	|

expuestos=
	Recuperados*tasa de exposición
	~	
	~	Recuperados que pierden la inmunidad y vuelven a ser susceptibles.
	|

vacunados=
	Susceptibles*tensión
	~	
	~	
	|

muertes=
	Infectados*tasa de mortalidad
	~	
	~	
	|

tasa de contagio=
	0.001
	~	
	~	
	|

tasa de curación=
	0.4
	~	
	~	
	|

tasa de exposición=
	0.05
	~	
	~	
	|

tensión=
	(enferman/Susceptibles)*tasa de vacunacion
	~	
	~	Riesgo percibido: fracción de susceptibles que enferma, por la tasa de vacunación.
	|

tasa de vacunacion=
	0.5
	~	
	~	
	|

tasa de mortalidad=
	0.1
	~	
	~	
	|

Total poblacion=
	Infectados+Recuperados+Susceptibles
	~	
	~	Variable de control: no influye en el resto del modelo.
	|

********************************************************
	.Control
********************************************************~
		Parametros de control de la simulacion
	|

FINAL TIME  = 20
	~	Mes
	~	El tiempo final de la simulacion.
	|

INITIAL TIME  = 0
	~	Mes
	~	El tiempo inicial de la simulacion.
	|

SAVEPER  = 
        TIME STEP
	~	Mes [0,?]
	~	Frecuencia con la que se guarda la salida.
	|

TIME STEP  = 1
	~	Mes [0,?]
	~	Paso de tiempo de la simulacion.
	|

